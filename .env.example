# ---------------------------------------------------------------
# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored - never commit real credentials.
# ---------------------------------------------------------------

# --- MySQL (system of record) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=disaster_relief
# One MySQL login per application role (created by database/sql/03_app_integration.sql)
# Use the same passwords you set in that file. Avoid "#" and "$" in values (dotenv treats them specially).
MYSQL_AUTH_USER=relief_auth
MYSQL_AUTH_PASSWORD=change-me
MYSQL_COORD_USER=relief_coord_app
MYSQL_COORD_PASSWORD=change-me
MYSQL_VOL_USER=relief_vol_app
MYSQL_VOL_PASSWORD=change-me

# --- MongoDB (intake forms + activity log) ---
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=relief_engine

# --- PostgreSQL + pgvector (vector database) ---
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=relief_vectors
PG_USER=relief_vector_app
# Same password as in database/vector/pgvector_setup.sql (section 5)
PG_PASSWORD=change-me

# --- Embeddings (runs locally, no API key) ---
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
# Optional: folder holding the model files for fully offline use
# EMBEDDING_MODEL_DIR=./models

# --- Auth ---
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-a-long-random-string
# Password given to the six sample users by `npm run seed:auth`
SEED_USER_PASSWORD=change-me-demo
